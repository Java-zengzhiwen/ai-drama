{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-drama.local/schemas/shot-prompt-set.schema.json",
  "title": "Shot Prompt Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "chapter_id",
    "source_storyboard_revision_id",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": "shot-prompt-canonical-v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "chapter_id": {
      "type": "string",
      "minLength": 1
    },
    "source_storyboard_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot_prompt"
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shot_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "shot_order",
        "duration_seconds",
        "scene_id",
        "character_ids",
        "prop_ids",
        "asset_refs",
        "camera",
        "action",
        "emotion",
        "dialogue",
        "positive_prompt",
        "negative_prompt",
        "continuity_notes",
        "agnes_video_params"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "shot_order": {
          "type": "integer"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 15
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "character_ids": {
          "$ref": "#/$defs/string_list"
        },
        "prop_ids": {
          "$ref": "#/$defs/string_list"
        },
        "asset_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "camera": {
          "type": "object"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "emotion": {
          "type": "string",
          "minLength": 1
        },
        "dialogue": {
          "type": "array"
        },
        "positive_prompt": {
          "type": "string",
          "minLength": 1
        },
        "negative_prompt": {
          "type": "string",
          "minLength": 1
        },
        "continuity_notes": {
          "$ref": "#/$defs/string_list"
        },
        "agnes_video_params": {
          "type": "object"
        }
      }
    }
  }
}
