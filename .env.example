# Optional OpenAI-compatible runtime configuration.
# Do not put real credentials in git.
AI_DRAMA_API_KEY=
AI_DRAMA_BASE_URL=
AI_DRAMA_MODEL=

# Fallback variables also supported:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# M3 real Agnes video smoke-test preparation.
# Do not put the Agnes API key in this file. Configure it through
# PUT /api/settings/agnes or LocalSecretStore.
AI_DRAMA_RUNTIME_PROVIDER=agnes
AI_DRAMA_PUBLIC_BASE_URL=https://<provider-reachable-domain>
AI_DRAMA_AGNES_VIDEO_RPM=1
AI_DRAMA_AGNES_POLL_INTERVAL_SECONDS=5
